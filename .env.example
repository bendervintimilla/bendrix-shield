# Copia a .env solo en local. Nunca commitees la llave real.
# En macOS también vale el llavero local.
META_MODEL_API_KEY=
# La doc de Meta usa MODEL_API_KEY para el SDK de OpenAI; meta_client acepta ambas.
MODEL_API_KEY=
SHIELD_REPLAY_DIR=replay-cache
SHIELD_REPLAY=0
# SHIELD_SPARK_REVIEW=on activa la revisión Spark por documento (solo `make live`; demo y pruebas van apagados).

# Spark Open: llave de Baseten/Modal. En local va en el vault
# (baseten-api-key); estas variables son para CI/Cloud Run.
BASETEN_API_KEY=
MODAL_API_KEY=
SHIELD_SPARK_OPEN_PROVIDER=baseten
# SHIELD_SPARK_OPEN_FALLBACK=modal
# SHIELD_SPARK_OPEN_MODAL_URL=
